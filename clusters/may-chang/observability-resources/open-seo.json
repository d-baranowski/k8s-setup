{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "description": "OpenSEO is uninstrumented — no OpenTelemetry, no /metrics endpoint — so every panel here comes from what the platform collects for any pod: kube-state-metrics, cAdvisor and Promtail. That covers process health and the boot-time build, not SEO work.",
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "0 means nothing is serving open-seo.folk-saiph.ts.net. A cold start legitimately sits at 0 for several minutes while the container rebuilds the app.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "kube_deployment_status_replicas_available{namespace=\"open-seo\", deployment=\"open-seo\"}", "legendFormat": "available", "refId": "A" }
      ],
      "title": "Available replicas",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Each restart costs a full multi-minute rebuild, so this number matters more here than for a normal app.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 4 } ] },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"open-seo\", container=\"open-seo\"}[24h]))", "legendFormat": "restarts", "refId": "A" }
      ],
      "title": "Restarts (24h)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "The boot build wants a 4 GiB heap on nodes that do not have much spare. If this is non-zero the container lost that race and will keep losing it.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "sum(kube_pod_container_status_last_terminated_reason{namespace=\"open-seo\", container=\"open-seo\", reason=\"OOMKilled\"}) or vector(0)", "legendFormat": "oomkilled", "refId": "A" }
      ],
      "title": "OOMKilled",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Time since the current pod started. Resets to zero on every restart — and every restart means another rebuild.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "text" }, "unit": "s" }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 5,
      "options": { "colorMode": "none", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "time() - max(kube_pod_start_time{namespace=\"open-seo\", pod=~\"open-seo-.*\"})", "legendFormat": "uptime", "refId": "A" }
      ],
      "title": "Pod uptime",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 6,
      "panels": [],
      "title": "Resources",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "The panel to look at first. docker-entrypoint.sh rebuilds the whole app on every container start with a 4 GiB heap, so each start shows as a spike toward the limit line. A spike that touches the limit is an OOMKill.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineInterpolation": "linear", "lineWidth": 2 },
          "unit": "bytes"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "limit" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }, { "id": "custom.fillOpacity", "value": 0 }, { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } } ] },
          { "matcher": { "id": "byName", "options": "request" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }, { "id": "custom.fillOpacity", "value": 0 }, { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } } ] }
        ]
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "id": 7,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] } },
      "targets": [
        { "expr": "sum(container_memory_working_set_bytes{namespace=\"open-seo\", container=\"open-seo\"})", "legendFormat": "working set", "refId": "A" },
        { "expr": "sum(kube_pod_container_resource_limits{namespace=\"open-seo\", container=\"open-seo\", resource=\"memory\"})", "legendFormat": "limit", "refId": "B" },
        { "expr": "sum(kube_pod_container_resource_requests{namespace=\"open-seo\", container=\"open-seo\", resource=\"memory\"})", "legendFormat": "request", "refId": "C" }
      ],
      "title": "Memory: working set vs limit",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Sustained pegging at the limit is the boot build (vite plus tsc). Steady-state serving should be near idle.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "limit" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }, { "id": "custom.fillOpacity", "value": 0 }, { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } } ] }
        ]
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "id": 8,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] } },
      "targets": [
        { "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"open-seo\", container=\"open-seo\"}[5m]))", "legendFormat": "cores used", "refId": "A" },
        { "expr": "sum(kube_pod_container_resource_limits{namespace=\"open-seo\", container=\"open-seo\", resource=\"cpu\"})", "legendFormat": "limit", "refId": "B" }
      ],
      "title": "CPU cores",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "/app/.wrangler — the D1 database plus every Durable Object's SQLite. local-path reports the underlying node filesystem, not the 10Gi request, so this is real free space on that node.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 9,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "min"] } },
      "targets": [
        { "expr": "kubelet_volume_stats_available_bytes{namespace=\"open-seo\", persistentvolumeclaim=\"open-seo-data\"}", "legendFormat": "available", "refId": "A" },
        { "expr": "kubelet_volume_stats_capacity_bytes{namespace=\"open-seo\", persistentvolumeclaim=\"open-seo-data\"}", "legendFormat": "capacity", "refId": "B" }
      ],
      "title": "Data volume",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Counts the 'Building client + server' line from docker-entrypoint.sh. Every bar is a full rebuild — the app is unreachable for the duration of each one.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 10,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] } },
      "targets": [
        { "expr": "sum(count_over_time({namespace=\"open-seo\"} |= \"Building client + server\" [$__interval]))", "legendFormat": "rebuilds", "queryType": "range", "refId": "A" }
      ],
      "title": "App rebuilds",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 11,
      "panels": [],
      "title": "Logs",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "A cold start prints, in order: the self-host preflight report, the D1 migrations, 'Building client + server', then vite preview listening. If the app seems down, read this before anything else.",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 24 },
      "id": 12,
      "options": { "dedupStrategy": "none", "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [
        { "expr": "{namespace=\"open-seo\"}", "queryType": "range", "refId": "A" }
      ],
      "title": "All logs",
      "type": "logs"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 36 },
      "id": 13,
      "options": { "dedupStrategy": "none", "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [
        { "expr": "{namespace=\"open-seo\"} |~ \"(?i)(error|fatal|failed|exception)\"", "queryType": "range", "refId": "A" }
      ],
      "title": "Errors",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["open-seo"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "OpenSEO / Overview",
  "uid": "open-seo-overview",
  "version": 1,
  "weekStart": ""
}
